# Copy to .env and fill in. Never commit .env (it holds secrets).
NODE_ENV=development
PORT=4000

# Local replica set (docker compose up -d) ...
MONGODB_URI=mongodb://127.0.0.1:27017,127.0.0.1:27018,127.0.0.1:27019/kaishare?replicaSet=rs0
# ... or MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/kaishare?retryWrites=true&w=majority

# At least 32 random characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=7
# true when the API is served over HTTPS (always true in production)
COOKIE_SECURE=false

# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web)
GOOGLE_CLIENT_ID=

# Generate with: npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@kaishare.nz

CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Optional HTTPS for the API (create with: npm run cert)
HTTPS_KEY_FILE=
HTTPS_CERT_FILE=

LOG_LEVEL=http
BCRYPT_ROUNDS=12
